<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>pid_loop_CSharp</RootNamespace>
    <ApplicationIcon>Assets\PID.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="usWaterTank.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="usWaterTank.Designer.cs">
      <DependentUpon>usWaterTank.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="usWaterTank.resx">
      <DependentUpon>usWaterTank.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="usOven.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="usOven.Designer.cs">
      <DependentUpon>usOven.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="usOven.resx">
      <DependentUpon>usOven.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="usMotor.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="usMotor.Designer.cs">
      <DependentUpon>usMotor.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="usMotor.resx">
      <DependentUpon>usMotor.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\PID.ico" />
    <None Include="Assets\pid_control_icon.svg" />
    <None Update="pid_loop.cfg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="pid_sampling.cfg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\pid_diagram.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
